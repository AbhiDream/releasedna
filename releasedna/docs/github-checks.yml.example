name: ReleaseDNA checks
on: [pull_request, push]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: python -m pip install -r releasedna/requirements-lock.txt
      - run: python -m unittest discover -s tests -q
        working-directory: releasedna/backend
      - run: python -m app.adversarial_corpus
        working-directory: releasedna/backend
      - run: node --check releasedna/frontend/app.js
